#!/bin/sh

# shellcheck disable=SC2034
description="Bundle of CA Root Certificates from Mozilla"
homepage="https://curl.se/docs/caextract.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ca-certificates
version=2026.11.05
release=1

_version="$(printf '%s' "${version}" | tr '.' '-')"
source="${name}-${version}.pem::https://curl.se/ca/cacert-${_version}.pem"

build() {
    install -Dm644 "${name}-${version}.pem" "${PKG}/etc/ssl/cert.pem"
    install -d "${PKG}/etc/ssl/certs"

    ln -s /etc/ssl/cert.pem "${PKG}/etc/ssl/certs/${name}.crt"
    ln -s /etc/ssl/cert.pem "${PKG}/etc/ssl/ca-bundle.crt"
}
