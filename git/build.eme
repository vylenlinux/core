#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Version control system designed to handle everything from small to very large projects with speed and efficiency"
homepage="https://git-scm.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=git
version=2.55.0
release=1
source="https://www.kernel.org/pub/software/scm/${name}/${name}-${version}.tar.xz"

build() {
    sed -i "s|git_exec_path = libexec|& / 'git-core'|" -i "${name}-${version}/meson.build"

    vylen-meson "${name}-${version}" build \
        -Druntime_prefix=true \
        -Dtests=false \
        -Drust="$(emerald is-installed rust && printf "enabled" || printf "disabled")"

    meson compile -C build -j "${JOBS:-1}"
    DESTDIR="${PKG}" meson install -C build
}
