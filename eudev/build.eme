#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Programs for dynamic creation of device nodes"
homepage="https://github.com/eudev-project/udev"
maintainer="Vylen Linux Team"

name=eudev
version=3.2.14
release=3
source="${name}-${version}.tar.gz::https://github.com/eudev-project/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    emerald is-installed libxslt && OPTS="--enable-manpages"

    # remove an unneeded group 'sgx'
    sed -i -e 's/GROUP="sgx", //' rules/50-udev-default.rules
    autoreconf -fis

    ./configure \
        --prefix=/usr \
        --bindir=/sbin \
        --sbindir=/sbin \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --libexecdir=/lib \
        --with-rootprefix= \
        --with-rootlibdir=/lib \
        --disable-static \
        "${OPTS}"

    make

    mkdir -p "${PKG}/lib/udev/rules.d"
    mkdir -p "${PKG}/etc/udev/rules.d"

    make DESTDIR="${PKG}" install

    do_service udev udev-settle udev-trigger
    install -d "${PKG}/etc/runlevels/sysinit"

    ln -sf "/etc/init.d/udev" -t "${PKG}/etc/runlevels/sysinit/"
    ln -sf "/etc/init.d/udev-trigger" -t "${PKG}/etc/runlevels/sysinit/"
}
