#!/bin/sh

# shellcheck disable=SC2034
description="Wrappers to build Python packages using PEP 517 hooks"
homepage="https://github.com/pypa/pep517"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-gpep517
version=23
release=1

source="${name}-${version}.tar.gz::https://github.com/mgorny/gpep517/archive/v${version}/gpep517-v${version}.tar.gz
    default.bytecode.level.patch
    gpep517"

build() {
    # shellcheck disable=SC2164
    cd "gpep517-${version}"

    patch -Np1 -i "${SRC}/default.bytecode.level.patch"
    mkdir -p "${PKG}/${PYTHON_SITE_PACKAGES}"

    cp -a gpep517 "${PKG}/${PYTHON_SITE_PACKAGES}"
    python3 -m compileall "${PKG}/${PYTHON_SITE_PACKAGES}"

    install -Dm755 "${SRC}/gpep517" -t "${PKG}/usr/bin/"
}
