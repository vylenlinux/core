#!/bin/sh

# shellcheck disable=SC2034
description="Wrappers to build Python packages using PEP 517 hooks"
homepage="https://github.com/gentoo/gpep517"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-gpep517
version=23
release=2
source="${name}-${version}.tar.gz::https://github.com/gentoo/gpep517/archive/v${version}/gpep517-v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "gpep517-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
