#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Provides data for network services and protocols"
homepage="https://www.iana.org/protocols"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=iana-etc
version=20260928
release=1

source="services
    protocols"

build() {
    install -Dm644 services protocols -t "${PKG}/etc/"
}
