#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Programs for basic and advanced IPV4-based networking"
homepage="https://git.kernel.org/pub/scm/network/iproute2/iproute2.git"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=iproute2
version=7.2.0
release=1

source="https://git.kernel.org/pub/scm/network/${name}/${name}.git/snapshot/${name}-${version}.tar.gz
    0001-make-iproute2-fhs-compliant.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/0001-make-iproute2-fhs-compliant.patch"

    make
    make SBINDIR=/usr/bin DESTDIR="${PKG}" install

    # remove unused (empty) directory
    rm -rf "${PKG}/usr/lib"
}
