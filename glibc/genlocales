#!/bin/sh

set -e

if [ "$(id -u)" != 0 ]; then
    printf "ERROR: %s need run as root!\n" "$(basename "${0}")"
    exit 1
fi

LOCALES=/etc/locales

rm -f /usr/lib/locale/locale-archive
mkdir -p /usr/lib/locale

while read -r locale charset; do
    case "${locale}" in
        "" | \#*) continue ;;
    esac

    if [ -n "${locale}" ] && [ -n "${charset}" ]; then
        if [ -f "/usr/share/i18n/locales/${locale}" ]; then
            input="${locale}"
        else
            input=$(printf "%s" "${locale}" | sed 's/\([^.]*\)[^@]*\(.*\)/\1\2/')
        fi

        printf 'Generate locale %s.%s...\n' "${locale}" "${charset}"
        localedef -i "${input}" -f "${charset}" "${locale}"
    fi
done < "${LOCALES}"

exit 0
