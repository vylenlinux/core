#!/bin/sh

pre_upgrade() {
    INSTALLED_VERSION="$(emerald info --field=installed perl | cut -d. -f1-2)"
    LATEST_VERSION="$(emerald info --field=version perl | cut -d. -f1-2)"

    [ "${INSTALLED_VERSION}" != "${LATEST_VERSION}" ] && printf 'yes' > /tmp/.perl-major-update
}

post_upgrade() {
    if [ -f /tmp/.perl-major-update ]; then
        emerald installed | awk '{print $1;}' | while read -r pkg; do
            [ "${pkg}" = "perl" ] && continue
            emerald files "${pkg}" | grep -Eq '^usr/lib/perl5/' && emerald install -fr "${pkg}"
        done

        rm -f /tmp/.perl-major-update
    fi
}
