#!/bin/sh

post_upgrade() {
    current="$(printf '%s' "$1" | cut -d. -f1-2)"
    latest="$(printf '%s' "$2" | cut -d. -f1-2)"

    if [ "$current" != "$latest" ]; then
        emerald installed | awk '{print $1;}' | while read -r pkg; do
            [ "${pkg}" = "perl" ] && continue
            emerald files "${pkg}" | grep -Eq '^usr/lib/perl5/' && emerald install -fr "${pkg}"
        done
    fi
}
