#!/bin/sh

# shellcheck disable=SC2034
description="Reading/writing various compression formats"
homepage="https://libarchive.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libarchive
version=3.8.11
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --disable-bsdcat \
        --without-iconv \
        --without-lz4 \
        --without-zstd \
        --without-nettle \
        --without-xml2 \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
