#!/usr/bin/env sh

# shellcheck disable=SC2034
description="An implementation of the DHCP client specified in RFC2131"
homepage="https://roy.marples.name/projects/dhcpcd/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dhcpcd
version=10.5.2
release=1
backup="etc/dhcpcd/dhcpcd.conf"

source="https://github.com/NetworkConfiguration/${name}/releases/download/v${version}/${name}-${version}.tar.xz
    ${name}.service
    ${name}_.service
    ${name}.sysusers
    ${name}.tmpfiles"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --libexecdir=/usr/lib/dhcpcd \
        --dbdir=/var/lib/dhcpcd \
        --sysconfdir=/etc/dhcpcd \
        --rundir=/run/dhcpcd \
        --privsepuser=dhcpcd

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/${name}.service" -t "${PKG}/usr/lib/systemd/system/"
    install -Dm644 "${SRC}/${name}_.service" "${PKG}/usr/lib/systemd/system/${name}@.service"
    install -Dm644 "${SRC}/${name}.sysusers" "${PKG}/usr/lib/sysusers.d/${name}.conf"
    install -Dm644 "${SRC}/${name}.tmpfiles" "${PKG}/usr/lib/tmpfiles.d/${name}.conf"
}
