#!/bin/sh

# shellcheck disable=SC2034
description="The systemd System and Service Manager"
homepage="https://systemd.io/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=systemd
version=262
release=1

source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/v${version}.tar.gz
    systemd.conf"

build() {
    sed \
        -e 's/GROUP="render"/GROUP="video"/' \
        -e 's/GROUP="sgx", //' \
    -i "${name}-${version}/rules.d/50-udev-default.rules.in"

    vylen-meson "${name}-${version}" build \
        -Ddefault-dnssec=no \
        -Dfirstboot=false \
        -Dinstall-tests=false \
        -Dman=auto \
        -Dsysusers=true \
        -Drpmmacrosdir=no \
        -Dhomed=disabled \
        -Duserdb=false \
        -Dmode=release \
        -Dpam=enabled \
        -Dpamconfdir=/etc/pam.d \
        -Ddev-kvm-mode=0660 \
        -Dnobody-group=nogroup \
        -Dsysupdate=disabled \
        -Dukify=disabled \
        -Dsplit-bin=false \
        -Dkernel-install=false \
        -Dsysupdated=disabled \
        -Ddocdir="/usr/share/doc/${name}-${version}" \
        -Dcompat-sysv-interfaces=false \
        -Dfallback-hostname='vylen' \
        \
        -Dmount-path=/usr/bin/mount \
        -Dumount-path=/usr/bin/umount \
        -Dswapon-path=/usr/bin/swapon \
        -Dswapoff-path=/usr/bin/swapoff \
        -Dagetty-path=/usr/bin/agetty \
        -Dkmod-path=/usr/bin/kmod \
        -Dlocalegen-path=/usr/bin/genlocales \
        \
        -Dsbat-distro='vylen' \
        -Dsbat-distro-summary='Vylen GNU/Linux' \
        -Dsbat-distro-pkgname="${name}" \
        -Dsbat-distro-version="${version}" \
        -Dsbat-distro-url="https://vylen.gitlab.io/packages/#${name}"

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    rm -rf "${PKG}/usr/share/factory"
    install -Dm644 "${SRC}/systemd.conf" -t "${PKG}/etc/ld.so.conf.d/"

    do_pam systemd-user
}
