#!/bin/sh

# shellcheck disable=SC2034
description="Functions for multiple precision math"
homepage="https://www.mpfr.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libmpfr
version=4.2.2
release=1
source="${name}-${version}.tar.xz::https://www.mpfr.org/mpfr-${version}/mpfr-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "mpfr-${version}"

    ./configure \
        --prefix=/usr \
        --disable-static \
        --enable-thread-safe

    make
    make DESTDIR="${PKG}" install
}
