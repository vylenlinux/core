#!/bin/sh

# shellcheck disable=SC2034
description="Utility for generating programs that recognize patterns in text"
homepage="https://github.com/westes/flex"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=flex
version=2.6.8
release=1
source="https://github.com/westes/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install

    ln -s "${name}" "${PKG}/usr/bin/lex"
}
