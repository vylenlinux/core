#!/bin/sh

# shellcheck disable=SC2034
description="Programs for handling passwords in a secure way"
homepage="https://github.com/shadow-maint/shadow"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=shadow
version=4.20.2
release=2

source="https://github.com/shadow-maint/${name}/releases/download/${version}/${name}-${version}.tar.xz
    pwck"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # shellcheck disable=SC2016
    sed -i 's|^usbindir = ${prefix}/sbin$|usbindir = ${prefix}/bin|' src/Makefile.am
    sed -i -e 's/^#ENCRYPT_METHOD.*/ENCRYPT_METHOD YESCRYPT/' etc/login.defs

    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --sbindir=/usr/bin \
        --libdir=/usr/bin \
        --sysconfdir=/etc \
        --disable-logind \
        --disable-nls \
        --disable-static \
        --enable-lastlog \
        --with-libpam \
        --with-yescrypt \
        --without-audit \
        --without-bcrypt \
        --without-libbsd \
        --without-selinux \
        --with-group-name-max-length=32

    make
    make pamddir= DESTDIR="${PKG}" install

    install -Dm755 "${SRC}/pwck" -t "${PKG}/etc/cron/daily/"

    do_pam chage chpasswd login passwd su
    sed -e "s/chpasswd/newusers/" "${PKG}/etc/pam.d/chpasswd" > "${PKG}/etc/pam.d/newusers"

    for bin in chfn chgpasswd chsh groupadd groupdel groupmems groupmod useradd userdel usermod; do
        install -m644 "${PKG}/etc/pam.d/chage" "${PKG}/etc/pam.d/${bin}"
        sed -i "s/chage/${bin}/" "${PKG}/etc/pam.d/${bin}"
    done
}
