#!/bin/sh

# shellcheck disable=SC2034
description="Programs for handling passwords in a secure way"
homepage="https://github.com/shadow-maint/shadow"
maintainer="Vylen Linux Team"

name=shadow
version=4.20.0
release=1

source="https://github.com/shadow-maint/${name}/releases/download/${version}/${name}-${version}.tar.xz
    https://github.com/shadow-maint/${name}/commit/ba4419c57b222b0d34a2b933e7ee92914a51b596.patch
    pwck"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # shellcheck disable=SC2016
    sed -i 's/groups$(EXEEXT) //' src/Makefile.in
    patch -Np1 -i "${SRC}/ba4419c57b222b0d34a2b933e7ee92914a51b596.patch"

    find man -name Makefile.in -exec sed -i 's/groups\.1 / /' {} \;
    find man -name Makefile.in -exec sed -i 's/getspnam\.3 / /' {} \;
    find man -name Makefile.in -exec sed -i 's/passwd\.5 / /' {} \;

    sed -i -e 's@#ENCRYPT_METHOD DES@ENCRYPT_METHOD YESCRYPT@' etc/login.defs

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-logind \
        --disable-nsl \
        --disable-static \
        --enable-lastlog \
        --with-yescrypt \
        --without-libbsd \
        --without-libpam \
        --with-group-name-max-length=32

    make
    make DESTDIR="${PKG}" install

    install -Dm755 "${SRC}/pwck" -t "${PKG}/etc/cron/daily/"
}
