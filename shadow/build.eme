#!/bin/sh

# shellcheck disable=SC2034
description="Programs for handling passwords in a secure way"
homepage="https://github.com/shadow-maint/shadow"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=shadow
version=4.20.3
release=1

backup="etc/login.defs
    etc/default/useradd"

source="https://github.com/shadow-maint/${name}/releases/download/${version}/${name}-${version}.tar.xz
    useradd.defaults"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # shellcheck disable=SC2016
    sed -i 's|^usbindir = ${prefix}/sbin$|usbindir = ${prefix}/bin|' src/Makefile.am
    sed -i -e 's/^#ENCRYPT_METHOD.*/ENCRYPT_METHOD YESCRYPT/' etc/login.defs

    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --sbindir=/usr/bin \
        --libdir=/usr/bin \
        --sysconfdir=/etc \
        --enable-logind \
        --enable-lastlog \
        --disable-nls \
        --disable-static \
        --with-libpam \
        --with-yescrypt \
        --without-audit \
        --without-bcrypt \
        --without-libbsd \
        --without-selinux \
        --disable-account-tools-setuid \
        --with-group-name-max-length=32

    make
    make pamddir= DESTDIR="${PKG}" install

    install -Dm600 "${SRC}/useradd.defaults" "${PKG}/etc/default/useradd"

    do_pam chage chpasswd login passwd su
    sed -e "s/chpasswd/newusers/" "${PKG}/usr/lib/pam.d/chpasswd" > "${PKG}/usr/lib/pam.d/newusers"

    for bin in chfn chgpasswd chsh groupadd groupdel groupmems groupmod useradd userdel usermod; do
        install -m644 "${PKG}/usr/lib/pam.d/chage" "${PKG}/usr/lib/pam.d/${bin}"
        sed -i "s/chage/${bin}/" "${PKG}/usr/lib/pam.d/${bin}"
    done

    do_service "${name}"

    install -dm755 "${PKG}/usr/lib/systemd/system/timers.target.wants"
    ln -s ../shadow.timer -t "${PKG}/usr/lib/systemd/system/timers.target.wants/"
}
