#!/bin/sh

# shellcheck disable=SC2034
description="Package compiler and linker metadata toolkit"
homepage="https://github.com/pkgconf/pkgconf"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pkgconf
version=3.0.8
release=1

source="https://github.com/${name}/${name}/releases/download/${name}-${version}/${name}-${version}.tar.xz
    ${name}-${version}-remove-api-util-test.patch"

build() {
    patch -d "${name}-${version}" -Np1 -i "${SRC}/${name}-${version}-remove-api-util-test.patch"

    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    ln -s pkgconf "${PKG}/usr/bin/pkg-config"
    rm -f "${PKG}/usr/lib/libpkgconf.a"
}
