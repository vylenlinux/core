#!/bin/sh

# shellcheck disable=SC2034
description="Utilities to administer the extended attributes on filesystem objects"
homepage="https://savannah.nongnu.org/projects/attr"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=attr
version=2.6.0
release=1
source="https://download-mirror.savannah.gnu.org/releases/${name}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --bindir=/bin \
        --disable-static \
        --sysconfdir=/etc \
        --disable-nls

    make
    make DESTDIR="${PKG}" install

    chmod 755 "${PKG}/usr/lib/libattr.so"
    mkdir -p "${PKG}/lib"

    mv "${PKG}/usr/lib"/libattr.so.* "${PKG}/lib/"
    ln -sf "../../lib/$(readlink "${PKG}/usr/lib/libattr.so")" "${PKG}/usr/lib/libattr.so"
}
