#!/usr/bin/env bash

# shellcheck disable=SC2034
description="POSIX compliant shell"
homepage="https://gondor.apana.org.au/~herbert/dash/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dash
version=0.5.13.5
release=1
source="https://gondor.apana.org.au/~herbert/${name}/files/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --bindir=/bin \
        --mandir=/usr/share/man

    make
    make DESTDIR="${PKG}" install

    ln -s dash "${PKG}/bin/sh"
}
