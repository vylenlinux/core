#!/bin/sh

# shellcheck disable=SC2034
description="utilities for handling the ext2, ext3 and ext4 file system"
homepage="https://e2fsprogs.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=e2fsprogs
version=1.47.4
release=1
source="https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/${name}/v${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --sbindir=/usr/bin \
        --with-root-prefix='' \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --enable-elf-shlibs \
        --disable-e2initrd-helper \
        --disable-nls \
        --disable-fsck \
        --disable-libblkid \
        --disable-libuuid \
        --disable-uuidd \
        --disable-fuse2fs

    make UDEV_RULES_DIR=/usr/lib/udev/rules.d
    make UDEV_RULES_DIR=/usr/lib/udev/rules.d DESTDIR="${PKG}" install install-libs

    for i in libcom_err libe2p libext2fs libss; do
        chmod u+w "${PKG}/usr/lib/${i}.a"
    done
}
