#!/bin/sh

# shellcheck disable=SC2034
description="A low-level library for installing from a Python wheel distribution"
homepage="https://github.com/pypa/installer"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-installer
version=1.1.0
release=1
source="${name}-${version}.tar.gz::https://github.com/pypa/installer/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "installer-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
