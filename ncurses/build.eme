#!/bin/sh

# shellcheck disable=SC2034
description="System V Release 4.0 curses emulation library"
homepage="https://invisible-island.net/ncurses/ncurses.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ncurses
version=6.6
release=1

_version="$(printf "%s" "${version}" | sed 's/\./_/g')"
snapshot=20251230

source="${name}-${version}.tar.gz::https://github.com/ThomasDickey/${name}-snapshots/archive/v${_version}_${snapshot}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-snapshots-${_version}_${snapshot}"
    sed -i '/LIBTOOL_INSTALL/d' c++/Makefile.in

    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man \
        --with-pkg-config-libdir=/usr/lib/pkgconfig \
        --with-shared \
        --without-debug \
        --without-normal \
        --enable-pc-files \
        --enable-widec

    make
    make DESTDIR="${PKG}" install

    ln -sf "libncursesw.so.${version}" "${PKG}/usr/lib/libncursesw.so"
    ln -s "libncursesw.so.${version}" "${PKG}/usr/lib/libncurses.so.${version%%.*}"

    # Create libtinfo symlinks.
    ln -sfr "${PKG}/usr/lib/libncursesw.so" "${PKG}/usr/lib/libtinfo.so"
    ln -sfr "${PKG}/usr/lib/libncursesw.so.${version}" "${PKG}/usr/lib/libtinfo.so.${version}"
    ln -sfr "${PKG}/usr/lib/libtinfo.so.${version}" "${PKG}/usr/lib/libtinfo.so.6"
    ln -sfr "${PKG}/usr/lib/pkgconfig/ncursesw.pc" "${PKG}/usr/lib/pkgconfig/tinfo.pc"

    for lib in ncurses form panel menu; do
        rm -f "${PKG}/usr/lib/lib${lib}.so"
        printf "INPUT(-l%sw)\n" "${lib}" > "${PKG}/usr/lib/lib${lib}.so"

        ln -sf "${lib}w.pc" "${PKG}/usr/lib/pkgconfig/${lib}.pc"
    done

    rm -f "${PKG}/usr/lib/libcursesw.so"
    printf "INPUT(-lncursesw)\n" > "${PKG}/usr/lib/libcursesw.so"

    ln -sf libncurses.so "${PKG}/usr/lib/libcurses.so"
}
