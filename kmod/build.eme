#!/bin/sh

# shellcheck disable=SC2034
description="Libraries and utilities for loading kernel modules"
homepage="https://git.kernel.org/pub/scm/utils/kernel/kmod/kmod.git"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=kmod
version=34.3
release=1
source="https://www.kernel.org/pub/linux/utils/kernel/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Ddlopen=all \
        -Dmanpages="$(emerald is-installed scdoc && printf 'true' || printf 'false')"

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
