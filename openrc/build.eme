#!/usr/bin/env sh

# shellcheck disable=SC2034
description="The OpenRC init system"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/OpenRC/openrc"

name=openrc
version=0.64.1
release=1
backup="etc/rc.conf"

source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${version}.tar.gz
    halt
    reboot"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    sed -i -e "s|@VCS_TAG@|${version}|" \
        src/shared/version.h.in \
        src/shared/version.in

    vylen-meson build \
        -Dbranding='"Vylen Linux"' \
        -Dpam=true \
        -Dpkgconfig=true \
        -Dselinux=disabled \
        -Dbash-completions=true \
        -Dzsh-completions=true

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    for i in $(seq 6); do
        ln -s agetty "${PKG}/etc/init.d/agetty.tty${i}"
        ln -sf "/etc/init.d/agetty.tty${i}" -t "${PKG}/etc/runlevels/default/"
    done

    ln -s openrc-init "${PKG}/usr/bin/init"
    ln -s openrc-shutdown "${PKG}/usr/bin/shutdown"

    install -Dm755 "${SRC}/halt" -t "${PKG}/usr/bin/"
    install -Dm755 "${SRC}/reboot" -t "${PKG}/usr/bin/"

    ln -sf halt "${PKG}/usr/bin/poweroff"
}
