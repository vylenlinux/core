#!/bin/sh

# shellcheck disable=SC2034
description="The GNU compiler collection, which includes the C and C++ compilers"
homepage="https://gcc.gnu.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gcc
version=16.2.0
release=1

source="https://ftp.gnu.org/gnu/${name}/${name}-${version}/${name}-${version}.tar.xz
    c89
    c99"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # /lib is 64bit libraries directory
    sed -e '/m64=/s/lib64/lib/' -i.orig gcc/config/i386/t-linux64

    mkdir build
    # shellcheck disable=SC2164
    cd build

    ../configure \
        --prefix=/usr \
        --libexecdir=/usr/lib \
        --disable-bootstrap \
        --disable-libmpx \
        --disable-libssp \
        --disable-libstdcxx-pch \
        --disable-nls \
        --disable-werror \
        --enable-__cxa_atexit \
        --enable-clocale=gnu \
        --enable-default-pie \
        --enable-default-ssp \
        --enable-languages=c,c++,objc,obj-c++,lto \
        --enable-lto \
        --enable-plugin \
        --enable-shared \
        --enable-multilib \
        --enable-threads=posix \
        --with-pkgversion="Vylen Linux ${version}-${release}" \
        --with-system-zlib \
        --with-x=no \
        --without-zstd

    make
    make -j1 DESTDIR="${PKG}" install

    mkdir "${PKG}/lib"
    ln -s ../usr/bin/cpp -t "${PKG}/lib/"
    ln -s gcc "${PKG}/usr/bin/cc"

    install -dm755 "${PKG}/usr/lib/bfd-plugins"
    ln -sf "../../lib/gcc/$(gcc -dumpmachine)/${version}/liblto_plugin.so" -t "${PKG}/usr/lib/bfd-plugins/"

    mkdir -p "${PKG}/usr/share/gdb/auto-load/usr/lib"
    mv "${PKG}/usr/lib"/*gdb.py -t "${PKG}/usr/share/gdb/auto-load/usr/lib/"

    install -Dm755 "${SRC}/c89" "${SRC}/c99" -t "${PKG}/usr/bin/"

    # rm -r "${PKG}/usr/share/${name}-${version}"
    python3 -m compileall "${PKG}/usr/share/${name}-${version}/"
    python3 -O -m compileall "${PKG}/usr/share/${name}-${version}/"
}
