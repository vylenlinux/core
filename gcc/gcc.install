#!/bin/sh

post_upgrade() {
    current="$(printf '%s' "$1" | cut -d. -f1)"
    latest="$(printf '%s' "$2" | cut -d. -f1)"

    if [ "${current}" != "${latest}" ]; then
        printf "For a GCC major version upgrade, the toolchain should be rebuilt with:\n"
        printf "  - pkgrebuild -t"
    fi
}
